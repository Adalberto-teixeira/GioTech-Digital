{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "giotech-digital",
  "main": "worker.js",
  "compatibility_date": "2026-08-28",
  "routes": [
    {
      "pattern": "giotech-digital.fr",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
